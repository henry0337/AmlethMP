<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. The session and its key cannot be restored on another device. -->
<full-backup-content>
    <!-- files/datastore/session.enc: keep in sync with SESSION_FILE_NAME in SessionDataStore.kt -->
    <exclude domain="file" path="datastore/session.enc" />
    <!-- Tink keyset: keep in sync with SessionAead.KEYSET_PREFS_NAME -->
    <exclude domain="sharedpref" path="session_keyset_prefs.xml" />
</full-backup-content>
