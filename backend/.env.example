APP_NAME=AmlethMP API
APP_ENV=development

# Encode reserved characters in the password (for example, @ becomes %40).
DATABASE_URL=postgresql+asyncpg://amlethmp_app:change-me@localhost:5432/amlethmp
DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Client ID of the Google OAuth client of type "Web application" (the same value as
# GOOGLE_WEB_CLIENT_ID in android/local.properties).
GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
