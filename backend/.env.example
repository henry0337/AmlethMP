APP_NAME=AmlethMP API
APP_ENV=development

# Encode reserved characters in the password (for example, @ becomes %40).
DATABASE_URL=postgresql+asyncpg://amlethmp_app:change-me@localhost:5432/amlethmp
DATABASE_ECHO=false
DATABASE_CONNECT_TIMEOUT=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Google OAuth for local development. Keep the secret only in this backend .env.
WEB_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
AUTH_SESSION_SECRET=
AUTH_SESSION_MAX_AGE_SECONDS=604800
AUTH_SESSION_COOKIE_SECURE=false
