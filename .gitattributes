# Normalize all text files to LF, in the repo and in the working tree,
# regardless of each developer's core.autocrlf setting.
* text=auto eol=lf

# Windows batch scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix scripts
gradlew text eol=lf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.jar binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
